<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YabaiOcr" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="android:statusBarColor">@color/panel_bg</item>
        <item name="android:navigationBarColor">@color/panel_bg</item>
    </style>

    <style name="Widget.YabaiOcr.PanelButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!--
      The doorway another app opens with a word (R37). It has no page of its own: with the overlay
      permission it starts the floating panel and finishes, so a transparent window means no dark
      flash between ReadEra and the panel. Without the permission the screen paints its own
      background in code and this stays invisible behind it.
    -->
    <!--
      The bubble's camera (R48a). It is a screen of its own, not a doorway: the preview, the shot
      and the picture waiting for the reading all happen here, so the page is black from the first
      frame and the bars are black too — a camera that flashes white on the way in reads as a bug.
    -->
    <style name="Theme.YabaiOcr.Camera" parent="Theme.YabaiOcr">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.YabaiOcr.Doorway" parent="Theme.YabaiOcr">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
