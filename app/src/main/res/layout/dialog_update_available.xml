<?xml version="1.0" encoding="utf-8"?>
<!--
  The update notice, laid out like the desktop window: a rounded card on the panel colour, the
  version in its own line, then the download as the filled primary action and the release notes
  as the outlined one. An AlertDialog's own dividers and flat background were the difference the
  user saw between the two platforms.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_available_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogUpdateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/dialogUpdateBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/update_dialog_body"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/dialogUpdateDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/update_download_button" />

    <Button
        android:id="@+id/dialogUpdateNotes"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/update_release_notes_button"
        android:textAllCaps="false"
        android:textColor="@color/accent" />

    <Button
        android:id="@+id/dialogUpdateLater"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="@string/update_close"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary" />
</LinearLayout>
