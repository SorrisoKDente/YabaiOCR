<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Draw the floating bubble above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Screen capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Foreground-service notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The AI apps the settings can offer, in the panel's «Perguntar à IA». Android 11+ hides the
      installed apps unless the app asks about them by intent, and an app that takes text is asked
      about exactly like this. Nothing is launched through it: the share itself is an ACTION_SEND.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YabaiOcr"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DictionaryActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/dictionary_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".HelpActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The word another app hands over (R35e). ReadEra's «Aplicativo de dicionário» list is made of
          the apps that accept text, so both doors of the platform are answered: «Processar texto» and
          the share sheet. This is only a doorway: with the overlay permission it starts
          LookupOverlayService and finishes, so the panel floats over the reader (R37); without it,
          the same screen opens as a dictionary search of its own.

          The affinity is a task of its own on purpose (R38). ReadEra opens the intent with
          FLAG_ACTIVITY_NEW_TASK, and with the app's affinity Android put this activity in the task
          the app already had — the one with MainActivity — and brought that whole task to the front.
          Finishing the doorway then showed the Yabai screen behind the panel instead of the reader.
          Alone in a task, the doorway takes the reader's place for one frame and the empty task is
          removed when it finishes, so the reader is what comes back.
        -->
        <activity
            android:name=".LookupActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=".lookup"
            android:theme="@style/Theme.YabaiOcr.Doorway">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StartOcrActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=".startocr"
            android:theme="@style/Theme.YabaiOcr.Doorway" />

        <!-- The panel another app asked for: one overlay window, gone with the panel (R37). -->
        <service
            android:name=".service.LookupOverlayService"
            android:exported="false" />

        <service
            android:name=".service.FloatingOcrService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Quick Settings Tile for starting OCR -->
        <service
            android:name=".service.YabaiTileService"
            android:exported="true"
            android:icon="@drawable/ic_scan"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
