<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Executar Yabai OCR ao finalizar" />
  <Property Id="WixShellExecTarget" Value="[INSTALLDIR]Yabai OCR.exe" />
  <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

  <UI>
    <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1</Publish>
  </UI>
</Include>
